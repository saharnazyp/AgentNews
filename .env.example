# توکن باتی که از @BotFather گرفتی (توی خود تلگرام، نه سایت)
BOT_TOKEN=123456789:AAExampleTokenHere

# کانالی که بات توش ادمینه و باید پست کنه
TARGET_CHANNEL=@my_output_channel

# کانال‌های منبع - یوزرنیم یا لینک کامل، با کاما جدا
SOURCE_CHANNELS=Artificial_intelligence_in,bestaitoolsai,hiaimediaen,perplexity,ai_news_world,ai_fans

# سرویس ترجمه (هر API سازگار با OpenAI)
TRANSLATE_API_KEY=your_api_key_here
TRANSLATE_BASE_URL=https://api.deepseek.com/v1
TRANSLATE_MODEL=deepseek-chat

# فقط پست‌های مرتبط با AI پست بشن؟
FILTER_AI_ONLY=True
